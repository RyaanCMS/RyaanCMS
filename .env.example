APP_NAME=RyaanCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ryaancms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ── Shared Hosting Settings ────────────────────────────────────────────────
# Uncomment the lines below if you are deploying on shared hosting (cPanel etc.)
# These replace database/redis drivers with file-based alternatives that work
# on any host without extra services.
#
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@ryaancms.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Provider Keys (Users can set their own via Settings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OLLAMA_HOST=http://localhost:11434

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL="${APP_URL}/auth/github/callback"

# RyaanCMS Settings
RYAAN_MAX_PROJECTS=10
RYAAN_AI_DEFAULT_PROVIDER=claude
RYAAN_ENABLE_MARKETPLACE=true
RYAAN_ENABLE_DEPLOYMENT=true

# API Cost Reduction (optional)
# RYAAN_AI_COST_MODE=normal        # normal | cheap | free
# RYAAN_AI_CACHE_TTL=1800          # seconds to cache identical AI responses (default 30 min)
# RYAAN_AI_TINY_HISTORY=1          # conversation turns sent for tiny edits (default 1)
